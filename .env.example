# For name in metrics
SERVICE_NAME=template

# HTTP Port
HTTP_PORT=8080

# Log level
LOG_LEVEL=info

# Auth settings
AUTH_TOKEN_ISSUER=template
AUTH_TOKEN_PUBLIC_KEY_PEM=
AUTH_TOKEN_PRIVATE_KEY_PEM=
AUTH_ACCESS_TOKEN_LIFE_TIME_IN_MINUTES=15
AUTH_REFRESH_TOKEN_LIFE_TIME_IN_MINUTES=43200

# Database DSN
DATABASE_PRIMARY_DSN=postgres://postgres:postgres@localhost:5432/template
DATABASE_REPLICA_DSN=postgres://postgres:postgres@localhost:5432/template